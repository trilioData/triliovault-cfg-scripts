            }
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Running"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Non-Running"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "pieType": "pie",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "pluginVersion": "11.3.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "264ea49f-0398-45c7-a86e-f197eb58f270"
          },
          "editorMode": "code",
          "expr": "sum by (status) (\r\n  label_replace(\r\n    kube_pod_status_phase{namespace=\"trilio-openstack\", phase=\"Running\", pod!~\"job-.*\"},\r\n    \"status\",\r\n    \"Running\",\r\n    \"phase\",\r\n    \".*\"\r\n  )\r\n) or\r\nsum by (status) (\r\n  label_replace(\r\n    kube_pod_status_phase{namespace=\"trilio-openstack\", phase!=\"Running\", pod!~\"job-.*\"},\r\n    \"status\",\r\n    \"Non-Running\",\r\n    \"phase\",\r\n    \".*\"\r\n  )\r\n)\r\n",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Trilio Control Plane Services Status",
      "type": "piechart"
    },
