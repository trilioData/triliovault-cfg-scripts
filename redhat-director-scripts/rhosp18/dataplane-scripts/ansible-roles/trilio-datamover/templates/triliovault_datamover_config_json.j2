{
  "command": "/opt/triliovault/start_triliovault_datamover.sh",
  "config_files": [
    {
      "source": "/var/lib/kolla/config_files/nova/nova-blank.conf",
      "dest": "/etc/nova/nova.conf",
      "owner": "nova",
      "perm": "0600"
    },
    {
      "source": "/var/lib/kolla/config_files/nova/*nova*.conf",
      "dest": "/etc/nova/nova.conf.d/",
      "owner": "nova",
      "perm": "0600"
    },
    {
      "dest": "/etc/triliovault-datamover/",
      "merge": true,
      "preserve_properties": true,
      "source": "/var/lib/kolla/config_files/triliovault-datamover/*"
    },
    {
      "dest": "/etc/ceph/",
      "merge": true,
      "source": "/var/lib/kolla/config_files/ceph/"
    },
    {
      "source": "/var/lib/kolla/config_files/triliovault-datamover/start_triliovault_datamover.sh",
      "dest": "/opt/triliovault/start_triliovault_datamover.sh",
      "owner": "nova",
      "perm": "0750"
    }
  ],
  "permissions": [
    {
      "owner": "nova:nova",
      "path": "/var/log/triliovault",
      "recurse": true
    },
    {
      "owner": "nova:nova",
      "path": "{{ vault_data_dir }}",
      "recurse": false
    },
    {
      "owner": "nova:nova",
      "path": "/etc/ceph",
      "perm": "0700"
    },
    {
      "owner": "nova:nova",
      "path": "/etc/ceph/*",
      "perm": "0600"
    }
  ]
}

