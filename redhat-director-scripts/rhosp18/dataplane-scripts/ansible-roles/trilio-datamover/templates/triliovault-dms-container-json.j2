{
    "image": "{{ triliovault_dms_image }}",
    "privileged": true,
    "user": "nova",
    "restart": "always",
    "command": "kolla_start",
    "net": "host",
    "ipc": "host",
    "environment": {
        "KOLLA_CONFIG_STRATEGY":"COPY_ALWAYS"
    },
    "volumes": [
        "{{ triliovault_dms_config_dest }}/triliovault_dms_config.json:/var/lib/kolla/config_files/config.json:ro",
        "/var/lib/openstack/config/triliovault-dms:/var/lib/kolla/config_files/triliovault-dms:ro",
{% if ca_bundle_exists|bool %}
        "{{ edpm_nova_tls_ca_src_dir }}/tls-ca-bundle.pem:/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem:ro,z",
{% endif %}
        "/etc/localtime:/etc/localtime:ro",
        "/lib/modules:/lib/modules:ro",
        "/dev:/dev",
{# The host's /run is intentionally not mounted here. The DMS server needs
   /run only for its own s3vaultfuse pid/lock files under /run/dms, which the
   image ships (owned by nova) in an image layer, so the container's own /run
   is enough. Mounting the host's /run made those paths depend on a tmpfs
   that is emptied on every node reboot, which left the service dead after a
   reboot until the data plane was redeployed (TVAULT-7655). The datamover
   container still mounts the host's /run - it genuinely needs it for
   libvirt. #}
        "/var/log/containers/triliovault-dms:/var/log/triliovault:z",
        "{{ vault_data_dir }}:{{ vault_data_dir }}:shared",
        "/etc/ssh/ssh_known_hosts:/etc/ssh/ssh_known_hosts:ro",
        "/boot:/boot:ro"
    ]
}

