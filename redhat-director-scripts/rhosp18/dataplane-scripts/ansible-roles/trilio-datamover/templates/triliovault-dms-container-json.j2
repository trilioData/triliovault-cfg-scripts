{
    "image": "{{ triliovault_dms_image }}",
    "privileged": true,
    "user": "nova",
    "restart": "always",
    "command": "kolla_start",
    "net": "host",
    "ipc": "host",
    "environment": {
        "KOLLA_CONFIG_STRATEGY":"COPY_ALWAYS"
    },
    "volumes": [
        "{{ triliovault_dms_config_dest }}/triliovault_dms_config.json:/var/lib/kolla/config_files/config.json:ro",
        "/var/lib/openstack/config/triliovault-dms:/var/lib/kolla/config_files/triliovault-dms:ro",
{% if ca_bundle_exists|bool %}
        "{{ edpm_nova_tls_ca_src_dir }}/tls-ca-bundle.pem:/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem:ro,z",
{% endif %}
        "/etc/localtime:/etc/localtime:ro",
        "/lib/modules:/lib/modules:ro",
        "/dev:/dev",
        "/run:/run",
        "/var/log/containers/triliovault-dms:/var/log/triliovault:z",
        "{{ vault_data_dir }}:{{ vault_data_dir }}:shared",
        "/etc/ssh/ssh_known_hosts:/etc/ssh/ssh_known_hosts:ro",
        "/boot:/boot:ro"
    ]
}

