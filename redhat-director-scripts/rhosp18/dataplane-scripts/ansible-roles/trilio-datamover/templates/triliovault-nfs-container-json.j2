{
    "image": "{{ triliovault_datamover_image }}",
    "privileged": true,
    "user": "nova",
    "restart": "always",
    "command": "kolla_start",
    "net": "host",
    "ipc": "host",
    "environment": {
        "KOLLA_CONFIG_STRATEGY":"COPY_ALWAYS"
    },
    "volumes": [
        "{{ triliovault_nfs_config_dest }}/triliovault_nfs_config-{{ triliovault_backup_target.backup_target_name }}.json:/var/lib/kolla/config_files/config.json:ro",
        "{{ triliovault_nfs_config_dest}}:/var/lib/kolla/config_files/triliovault-nfs:ro",
        "{{ vault_data_dir }}:{{ vault_data_dir }}:shared"
    ]
}

