{{- if and (eq .Values.crdType "TVOControlPlane") (.Values.database.common.use_trilio_galera) }}
---
apiVersion: v1
kind: Service
metadata:
  name: trilio-galera-lb
  namespace: {{ .Release.Namespace }}
  annotations:
    metallb.universe.tf/address-pool: {{ .Values.common.metallb_address_pool }}
    dnsmasq.network.openstack.org/hostname: trilio-galera-lb.{{ .Release.Namespace }}.svc
  labels:
    app.kubernetes.io/component: database
    app.kubernetes.io/name: trilio-db-cluster
    app.kubernetes.io/part-of: trilio-vault
spec:
  type: LoadBalancer
  selector:
    # RHOSO's mariadb-operator labels Galera pods with "service: <CR-name>-galera"
    # (internal/mariadb/utils.go StatefulSetLabels/StatefulSetName) — it never sets
    # app.kubernetes.io/name, so that key would never match any pod.
    service: trilio-db-cluster-galera
  ports:
  - name: mysql
    port: 3306
    targetPort: 3306
    protocol: TCP
  sessionAffinity: ClientIP
  sessionAffinityConfig:
    clientIP:
      timeoutSeconds: 10800
  externalTrafficPolicy: Cluster
{{- end }}