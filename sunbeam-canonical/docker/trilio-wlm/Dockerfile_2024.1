FROM ubuntu:jammy
MAINTAINER TrilioData shyam.biradar@trilio.io

LABEL name="trilio-wlm-canonical" \
      maintainer="shyam.biradar@trilio.io" \
      vendor="TrilioData" \
      version="6.2.1" \
      release="6.2" \
      type="source" \
      summary="TrilioVault WorkloadManager for Canonical Sunbeam" \
      description="TrilioVault WLM (wlm-api, wlm-workloads, wlm-scheduler, wlm-cron) on Ubuntu Jammy for Sunbeam k8s"

USER root

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC

# Base system packages + ubuntu-cloud-keyring (provides UCA signing key without keyserver access)
RUN apt-get -y update && \
    apt-get -y install --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        sudo \
        nfs-common \
        fuse \
        libfuse2 \
        zlib1g-dev \
        libpython3-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        python3-m2crypto \
        libmysqlclient-dev \
        qemu-utils \
        libxml2-dev \
        libxslt-dev \
        libvirt-clients \
        kmod \
        python3-pip \
        ubuntu-cloud-keyring \
    && apt-get clean -y \
    && rm -rf /var/lib/apt/lists/*

# Add Ubuntu Cloud Archive for OpenStack Caracal (2024.1)
# Write source entry directly — ubuntu-cloud-keyring already ships the signing key
RUN echo "deb https://ubuntu-cloud.archive.canonical.com/ubuntu jammy-updates/caracal main" \
        > /etc/apt/sources.list.d/cloudarchive-caracal.list && \
    apt-get update -y

# OpenStack Python packages needed by WLM at runtime
RUN apt-get install -y \
        nova-common \
        python3-nova \
        python3-novaclient \
        python3-neutronclient \
        python3-glanceclient \
    && apt-get clean -y

# pip packages not available in cloud-archive
RUN pip3 --no-cache-dir install "SQLAlchemy==1.4.51" && \
    pip3 --no-cache-dir install --upgrade pyvmomi munch paramiko taskflow && \
    pip3 --no-cache-dir install azure-storage-blob==12.25.1 azure-core loguru

# Install TrilioVault WLM packages from Trilio APT repo
ADD trilio.list /etc/apt/sources.list.d/
RUN apt-get update -y && \
    apt-get install -o Dpkg::Options::="--force-confold" --force-yes -y \
        workloadmgr \
        python3-workloadmgrclient \
        python3-contegoclient \
        python3-trilio-dms \
        python3-s3-fuse-plugin \
    --allow-unauthenticated && \
    apt-get clean -y && \
    rm -rf /var/lib/apt/lists/* && \
    rm -f /etc/apt/sources.list.d/trilio.list

# python3-s3-fuse-plugin declares boto3==1.35.12/botocore==1.35.12 (see its
# dist-info requires) but apt/pip leaves much older versions installed
# (boto3 1.20.34/botocore 1.23.34), which crash s3vaultfuse at import time:
# "ImportError: cannot import name 'DEFAULT_CIPHERS' from 'urllib3.util.ssl_'"
# — that botocore predates urllib3 2.x. Pin explicitly to what the package
# itself requires. This image is used for both the WLM containers and the
# embedded DMS sidecar container, so the fix covers all s3vaultfuse usage.
RUN pip3 --no-cache-dir install 'boto3==1.35.12' 'botocore==1.35.12'

# workloadmgr/api/common.py's remove_version_from_href() assumes the API
# version ("v1") is always the first URL path segment (e.g. "/v1/<tenant>"),
# which holds for kolla/RHOSP (WLM exposed directly on its own port, no path
# prefix) but not Sunbeam: Traefik ingress routes all OpenStack services off
# shared host IPs by path prefix, so WLM's registered endpoint is
# "/trilio-wlm/v1/<tenant>" — version is the *second* segment. The unpatched
# function raises "href ... does not contain version" on every self-referential
# href it builds during workload-create. Patch it to find the version segment
# anywhere in the path instead of assuming position 1.
COPY patch_remove_version_from_href.py /tmp/patch_remove_version_from_href.py
RUN python3 /tmp/patch_remove_version_from_href.py && \
    rm -f /tmp/patch_remove_version_from_href.py

# Migration 030: add WorkloadsBase audit columns (created_at, updated_at,
# deleted_at, deleted, version) and progress to the job table.
# The job table was created in migration 001 with only jobid/status/action,
# and parent_jobid was added in 029. These columns were added to the Job model
# (via WorkloadsBase) but the migration was never included, causing INSERT
# failures in job_service.py on fresh installs.
COPY 030_add_job_audit_columns.py \
    /usr/lib/python3/dist-packages/workloadmgr/db/sqlalchemy/migrate_repo/versions/030_add_job_audit_columns.py

# Create required directories
RUN mkdir -p \
    /etc/triliovault-wlm \
    /etc/triliovault-object-store \
    /etc/triliovault-dms \
    /var/trilio/triliovault-mounts \
    /var/triliovault \
    /var/log/triliovault \
    /var/lib/workloadmgr/taskflow \
    /opt/triliovault

# All WLM services run as root
RUN chmod -R 755 \
        /var/log/triliovault \
        /etc/triliovault-wlm \
        /etc/triliovault-object-store && \
    chmod -R 777 \
        /var/trilio/triliovault-mounts \
        /var/triliovault

USER root
