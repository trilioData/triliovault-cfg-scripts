[DEFAULT]
vault_data_directory = /var/triliovault-mounts
vault_data_directory_old = /var/triliovault

log_config_append = /etc/triliovault-datamover/datamover_logging.conf

debug = {{ debug }}
verbose = True
max_uploads_pending = 3
max_commit_pending = 3
qemu_agent_ping_timeout = 30

dmapi_transport_url = {{ transport_url }}

[contego_sys_admin]
# Must use tvault-contego-rootwrap — bare privsep-helper bypasses the rootwrap
# filter allow-list and causes permission errors on disk/mount operations.
helper_command = sudo /usr/bin/tvault-contego-rootwrap {{ dm_config_path }} privsep-helper

[s3fuse_sys_admin]
helper_command = sudo /usr/bin/trilio-dms-rootwrap /etc/triliovault-dms/rootwrap.conf privsep-helper

[conductor]
use_local = True

[oslo_messaging_rabbit]
ssl = false
# nova.conf (loaded alongside this file) already sets rabbit_quorum_queue,
# but state it explicitly here too so it can't silently drift from
# dm-api/DMS/WLM's own value — a mismatched durability flag on a shared-name
# queue gets a 406 PRECONDITION_FAILED from RabbitMQ (quorum queues are
# always durable).
rabbit_quorum_queue = {{ rabbit_quorum_queue }}
amqp_durable_queues = {{ amqp_durable_queues }}

[barbican]
barbican_endpoint_type = internal
verify_ssl = {{ 'true' if cafile else 'false' }}
{% if cafile %}verify_ssl_path = {{ cafile }}
{% endif %}

[libvirt]
# openstack-hypervisor's embedded libvirtd resolves the connecting peer's uid via
# its own snap-confined /etc/passwd — a point-in-time bind-mount snapshot taken
# when the snap's daemons last started, which predates the host's nova user. A
# direct qemu+unix:// connection (as nova, uid 42436) fails with "Failed to find
# user record for uid '42436'" once past the socket-permission stage. Routing the
# connection through contego-libvirt-connect (sudo-wrapped nc, connects as root)
# makes the peer uid 0, which always resolves — sidestepping the lookup entirely.
# TVAULT-7404: may be reverted to qemu+unix:// if a different fix is adopted.
connection_uri = qemu+ext:///system?command=/usr/local/bin/contego-libvirt-connect
{% if ceph_backend_enabled %}
# Matches kolla-ansible's own datamover conf (rendered when cinder_backend_ceph
# is true) and RHOSO18's libvirt_images_rbd_ceph_conf default — feeds Nova's own
# Rbd image-backend class, which contego's rbd backend subclasses.
images_rbd_ceph_conf = {{ ceph_conf_path }}
rbd_user = {{ ceph_client_name }}

[ceph]
keyring_ext = .keyring
{% endif %}
