# Thin dispatch stub — the real implementation lives in actions.py.
#
# Juju invokes this file directly by its action name; actions.py's main()
# determines which action to run from os.path.basename(sys.argv[0]), so
# this file never needs to change when actions.py changes. This replaces
# the previous convention of hand-copying the whole of actions.py into
# every action-name file, which had already caused real drift between
# them (see juju-charms/CLAUDE.md).

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from actions import main  # noqa

if __name__ == "__main__":
    sys.exit(main(sys.argv))
