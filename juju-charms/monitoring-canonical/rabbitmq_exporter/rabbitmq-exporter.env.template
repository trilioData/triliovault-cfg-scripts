RABBIT_URL=http://${RABBITMQ_HOST}:15672
RABBIT_USER=${RABBITMQ_MONITORING_USER}
RABBIT_PASSWORD=${RABBITMQ_MONITORING_PASSWORD}
# Only scrape the Trilio vhost. Canonical's charms relate wlm/dm-api/data-mover/dms
# to a single shared vhost (confirm with `rabbitmqctl list_vhosts` — this is NOT
# the "workloadmgr"/"dmapi" split used by the RHOSO Operator-managed RabbitMQ).
INCLUDE_VHOST=^triliowlm$
# Export queue-level and exchange-level metrics
RABBIT_EXPORTERS=queue,exchange
PUBLISH_PORT=9419
OUTPUT_FORMAT=prometheus
SKIPVERIFY=true
