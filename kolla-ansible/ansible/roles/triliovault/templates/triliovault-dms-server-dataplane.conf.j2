[server]
rabbitmq_url = rabbit://openstack:{{ om_rpc_password }}@{{ hostvars[groups[om_rpc_group][0]]['ansible_' + hostvars[groups[om_rpc_group][0]]['api_interface']]['ipv4']['address'] }}:{{ rabbitmq_port }}/

{% if rabbit_quorum_queue | bool %}
rabbitmq_queue_type = quorum
{% endif %}

# Node identifier — must match OS-EXT-SRV-ATTR:host from nova (the nova-compute host value)
node_id = {{ inventory_hostname }}

# Keystone auth URL for Barbican token validation
auth_url = {{ keystone_internal_url }}

# Barbican SSL verification
barbican_ssl_verify = {{ 'True' if openstack_cacert else 'False' }}
{% if openstack_cacert %}
barbican_ca_bundle = {{ openstack_cacert }}
{% endif %}

# s3vaultfuse binary path
s3vaultfuse_bin = /usr/bin/s3vaultfuse.py

# rootwrap paths
rootwrap_bin = /usr/bin/trilio-dms-rootwrap
rootwrap_conf = /etc/triliovault-dms/rootwrap.conf

# Logging
log_file = /var/log/triliovault/trilio-dms-server.log
log_level = INFO
log_max_bytes = 26214400
log_backup_count = 5

# Parallel worker threads for different (host, backup_target_id) pairs
worker_threads = 10
