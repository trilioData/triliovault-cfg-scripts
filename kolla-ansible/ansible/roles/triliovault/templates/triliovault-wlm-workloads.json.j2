{
	"command": "/opt/triliovault/start-triliovault-wlm-workloads.sh",
	"config_files": [
		{
			"source": "{{ container_config_directory }}/triliovault-wlm-workloads.conf",
			"dest": "/etc/triliovault-wlm/triliovault-wlm.conf",
			"owner": "nova",
			"perm": "0755"
		},
		{
			"source": "{{ container_config_directory }}/triliovault-wlm-logging.conf",
			"dest": "/etc/triliovault-wlm/wlm_logging.conf",
			"owner": "nova",
			"perm": "0755"
		},
		{
			"source": "{{ container_config_directory }}/api-paste.ini",
			"dest": "/etc/triliovault-wlm/api-paste.ini",
			"owner": "nova",
			"perm": "0755"
		},
		{
			"source": "{{ container_config_directory }}/fuse.conf",
			"dest": "/etc/fuse.conf",
			"owner": "nova",
			"perm": "0644"
		},
		{
			"source": "{{ container_config_directory }}/start-triliovault-wlm-workloads.sh",
			"dest": "/opt/triliovault/start-triliovault-wlm-workloads.sh",
			"owner": "nova",
			"perm": "0755"
		},
		{
			"source": "{{ container_config_directory }}/triliovault-dms-client.conf",
			"dest": "/etc/triliovault-dms/client.conf.d/kolla-client.conf",
			"owner": "nova",
			"perm": "0640"
		}
	],
	"permissions": [{
		"path": "/var/log/triliovault",
		"owner": "nova:nova"
	}]
}
