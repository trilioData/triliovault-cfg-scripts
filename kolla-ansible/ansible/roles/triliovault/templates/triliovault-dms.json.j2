{
    "command": "/usr/bin/python3 /usr/bin/trilio-dms-server --config-file /etc/triliovault-dms/server.conf",
    "config_files": [
        {
            "source": "{{ container_config_directory }}/triliovault-dms-server.conf",
            "dest": "/etc/triliovault-dms/server.conf",
            "owner": "nova",
            "perm": "0640"
        },
        {
            "source": "{{ container_config_directory }}/s3vaultfuse-global.conf",
            "dest": "/etc/triliovault-dms/s3vaultfuse-global.conf",
            "owner": "nova",
            "perm": "0644"
        }
    ],
    "permissions": [
        {
            "path": "/var/log/triliovault",
            "owner": "nova:nova",
            "recurse": true
        }
    ]
}
