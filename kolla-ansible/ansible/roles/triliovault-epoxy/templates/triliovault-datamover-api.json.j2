{
	"command": "/opt/triliovault/start-triliovault-datamover-api.sh",
	"config_files": [{
			"source": "{{ container_config_directory }}/triliovault-datamover-api.conf",
			"dest": "/etc/triliovault-datamover/triliovault-datamover-api.conf",
			"owner": "dmapi",
			"perm": "0755"
		},
	        {
			"source": "{{ container_config_directory }}/triliovault-datamover-api-logging.conf",
			"dest": "/etc/triliovault-datamover/datamover_api_logging.conf",
			"owner": "dmapi",
			"perm": "0755"
		},
		{
			"source": "{{ container_config_directory }}/start-triliovault-datamover-api.sh",
			"dest": "/opt/triliovault/start-triliovault-datamover-api.sh",
			"owner": "nova",
			"perm": "0755"
        }{% if kolla_copy_ca_into_containers | bool %},
        {
            "source": "{{ container_config_directory }}/ca-certificates",
            "dest": "/var/lib/kolla/share/ca-certificates",
            "owner": "root",
            "perm": "0600"
        }{% endif %}
	],
	"permissions": [{
		"path": "/var/log/triliovault",
        "owner": "dmapi:dmapi"
	}]
}
