FROM quay.io/openstack.kolla/nova-api:2024.1-ubuntu-jammy
MAINTAINER TrilioData shyam.biradar@trilio.io

LABEL name="kolla/trilio-dms" \
      maintainer="shyam.biradar@trilio.io" \
      vendor="TrilioData" \
      version="6.2.0" \
      release="6.2" \
      type="source" \
      summary="TrilioData TrilioVault DMS" \
      description="TrilioData TrilioVault Dynamic Mount Service (Ubuntu Jammy)"

USER root

ADD trilio.list /etc/apt/sources.list.d/
RUN apt-get update -y

RUN apt-get install -o Dpkg::Options::="--force-confold" --force-yes -y \
    fuse libfuse2 nfs-common \
    python3-trilio-dms python3-s3-fuse-plugin --allow-unauthenticated

RUN /usr/bin/pip3 install --upgrade pip \
    && /usr/bin/pip3 install azure-storage-blob==12.25.1 azure-core loguru

RUN echo "user_allow_other" > /etc/fuse.conf

RUN usermod -u 42436 nova && groupmod -g 42436 nova && usermod -aG kolla nova

## The host's /run is deliberately NOT bind-mounted into this container
## (see triliovault_dms_default_volumes). The DMS server keeps its
## s3vaultfuse pid files and lock files under /run/dms, and the host's /run
## is a tmpfs that is emptied on every node reboot - so a host directory
## would have to be recreated on every boot by something outside the
## container. Baking the tree into an image layer instead means it is always
## present on a container start, a recreate and a node reboot, with no
## runtime step at all (TVAULT-7655).
## Ownership must be applied to /run/dms itself and not only to its
## children: the server creates any missing subdirectory with os.makedirs(),
## which needs write permission on the parent.
RUN mkdir -p \
    /var/lib/trilio/triliovault-mounts \
    /var/triliovault \
    /etc/triliovault-dms/client.conf.d \
    /var/log/triliovault \
    /run/dms/s3 \
    /run/dms/locks \
    && chmod 777 /var/lib/trilio/triliovault-mounts \
    && chmod 0755 /run/dms /run/dms/s3 /run/dms/locks \
    && chown -R nova:nova \
        /var/lib/trilio/triliovault-mounts \
        /var/log/triliovault \
        /run/dms \
        /etc/triliovault-dms

COPY extend_start.sh /usr/local/bin/kolla_extend_start

RUN mkdir -p /opt/triliovault && chown -R nova:nova /opt/triliovault

RUN apt-get clean -y
RUN rm -f /etc/apt/sources.list.d/trilio.list

RUN mkdir /licenses
COPY licensing.txt /licenses

USER nova
