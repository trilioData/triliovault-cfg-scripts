FROM ghcr.io/canonical/horizon:2023.1
# Uncomment below to use the latest edge image instead of stable:
# FROM ghcr.io/canonical/horizon:2023.1-22.04_edge
MAINTAINER TrilioData shyam.biradar@trilio.io

LABEL name="sunbeam-canonical-trilio-horizon-plugin" \
      maintainer="shyam.biradar@trilio.io" \
      vendor="TrilioData" \
      version="6.2.1" \
      release="6.2" \
      type="source" \
      summary="TrilioVault Horizon Plugin" \
      description="TrilioVault Horizon Plugin for Sunbeam Canonical OpenStack"

##Install required packages
ARG TRILIO_PIP_INDEX_URL="DEFAULT"
RUN apt-get update && apt-get install -y python3-pip && rm -rf /var/lib/apt/lists/*
RUN export PIP_EXTRA_INDEX_URL=${TRILIO_PIP_INDEX_URL} && pip3 install tvault-horizon-plugin workloadmgrclient contegoclient --no-deps
RUN TRILIO_PKG=$(python3 -c "import trilio_dashboard, os; print(os.path.dirname(trilio_dashboard.__file__))") && cp ${TRILIO_PKG}/local/enabled/*.py /usr/lib/python3/dist-packages/openstack_dashboard/enabled/
RUN TRILIO_PKG=$(python3 -c "import trilio_dashboard, os; print(os.path.dirname(trilio_dashboard.__file__))") && cp ${TRILIO_PKG}/templatetags/*.py /usr/lib/python3/dist-packages/openstack_dashboard/templatetags/

#
RUN /usr/bin/python3 /usr/share/openstack-dashboard/manage.py collectstatic --clear --noinput
RUN /usr/bin/python3 /usr/share/openstack-dashboard/manage.py compress --force


## Add license
RUN mkdir /licenses
COPY licensing.txt /licenses
